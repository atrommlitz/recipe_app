# Copy to .env.local and fill in.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# https://console.anthropic.com -> API Keys
# Only needed for the link and Paprika importers.
ANTHROPIC_API_KEY=

# The Supabase account the shared password signs into. Not user-facing —
# nobody types this. Kept out of source so the repo can stay public.
HOUSEHOLD_EMAIL=you@example.com
